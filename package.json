{
  "name": "eterea-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:bootstrap-owner": "tsx scripts/bootstrap-owner.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test": "tsx --test src/test/storefront-rules.test.ts src/test/cloudinary-media.test.ts src/test/image-cleanup.test.ts src/test/image-file.test.ts src/test/image-presentation.test.ts src/test/instagram-crypto.test.ts src/test/instagram-media.test.ts src/test/instagram-meta.test.ts src/test/instagram-section.test.tsx src/test/content-catalog.test.ts src/test/home-category-cards.test.ts src/test/relational-content.test.ts src/test/storefront-projection.test.ts src/test/product-relations.test.ts src/test/payment-prices.test.tsx src/test/product-editor-snapshot.test.ts src/test/product-detail-gallery.test.ts src/test/cart-checkout.test.ts src/test/correo-argentino.test.ts src/test/rate-limit-policy.test.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:audit-performance": "tsx scripts/audit-performance.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.575.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.16.5",
