# Cadena MySQL/TiDB; para TiDB Cloud usá el host, puerto y TLS indicados por tu clúster.
DATABASE_URL="mysql://usuario:contraseña@host:4000/eterea?sslaccept=strict"
# En la consola, generá uno con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Pegá el resultado acá. No lo compartas ni lo subas al repositorio.
AUTH_SECRET="reemplazar-por-un-secreto-aleatorio-largo"
# Solo para crear la primera cuenta en una base vacía. Usá valores temporales y retiralos después.
BOOTSTRAP_OWNER_USERNAME=""
BOOTSTRAP_OWNER_NAME=""
BOOTSTRAP_OWNER_PASSWORD=""
# Credenciales de Cloudinary. La API Secret se usa solo en el servidor.
CLOUDINARY_CLOUD_NAME="nombre-de-cloud"
CLOUDINARY_API_KEY="api-key"
CLOUDINARY_API_SECRET="api-secret"
